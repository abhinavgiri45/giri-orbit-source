# Android SDK Location Example
# Copy this file to local.properties and update the sdk.dir path to your local Android SDK
#
# Windows Example:
# sdk.dir=C\:\\Users\\username\\AppData\\Local\\Android\\Sdk
#
# macOS Example:
# sdk.dir=/Users/username/Library/Android/sdk
#
# Linux Example:
# sdk.dir=/home/username/Android/Sdk
